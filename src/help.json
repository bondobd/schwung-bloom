{
    "title": "Bloom",
    "children": [
        {
            "title": "Overview",
            "lines": [
                "Bloom is a chord",
                "instrument. It plays",
                "Move's own tracks:",
                "chords on Track 3,",
                "bass on Track 2.",
                "",
                "Chords follow the",
                "Set's key and scale."
            ]
        },
        {
            "title": "Pads",
            "lines": [
                "Bottom row: major",
                "chords, root to",
                "octave of the key.",
                "",
                "Row 2: minor chords",
                "(dim where the key",
                "has it).",
                "",
                "Row 3: strum the",
                "held chord's notes.",
                "Let go and it stays",
                "on the last chord.",
                "",
                "Top row: hold to",
                "colour a chord:",
                " Sus2 Sus4 Dim Aug",
                " 7 Maj7 6 Add9",
                "",
                "Tap one while you",
                "hold a chord and it",
                "stays on: strum it.",
                "Tap again: off.",
                "One of each kind",
                "combines: sus/dim/",
                "aug, 7th or 6th,",
                "add9. A new one",
                "replaces its kind.",
                "",
                "Lit = in key.",
                "Rose top pads add",
                "notes outside it."
            ]
        },
        {
            "title": "Pick and strike",
            "lines": [
                "Shift+Loop toggles.",
                "",
                "Tap a chord pad to",
                "pick it silently,",
                "then strike the top",
                "row to play it:",
                " Plain Sus2 Sus4 6",
                " 7 Maj7 Add9 9",
                "",
                "The strum row stays",
                "on the last chord,",
                "so you can let go."
            ]
        },
        {
            "title": "Progressions",
            "lines": [
                "Capture: a new",
                "4-chord idea in key.",
                "Shift+Capture: 8.",
                "",
                "Shift+Step: save the",
                "last chord to step,",
                "as hard as you hit",
                "it.",
                "Step: play it.",
                "Delete+Step: clear.",
                "Undo: take it back.",
                "",
                "Wheel, nothing held:",
                "a new take on every",
                "chord. Left = back.",
                "",
                "Left/Right: previous",
                "or next chord."
            ]
        },
        {
            "title": "Program a step",
            "lines": [
                "Hold a step. Knobs",
                "set how it plays:",
                " 1 Mode  2 Length",
                " 3 Speed 4 Gate",
                " 5 Vol   6 Bass",
                " 7 Spread 8 Feel",
                "Turn to the start",
                "for DEFAULT (gate",
                "and vol: 100%).",
                "",
                "Wheel: new voicing.",
                "Wheel click: plain.",
                "-/+: semitone.",
                "Long -/+: octave.",
                "Volume knob: volume."
            ]
        },
        {
            "title": "Play and record",
            "lines": [
                "Play: Move and the",
                "loop range start",
                "together, in time.",
                "Play again: stop.",
                "Shift+Play: every",
                "step.",
                "",
                "Hold Loop, tap first",
                "and last step: loop",
                "those. Loop alone:",
                "all steps.",
                "",
                "Record: a live take",
                "on the chord track.",
                "Play steps, pads,",
                "strums: all goes in.",
                "Record again: stop.",
                "",
                "Shift+Record: the",
                "progression to the",
                "chord track, then",
                "bass to the bass",
                "track. Count-in is",
                "fine."
            ]
        },
        {
            "title": "Knobs",
            "lines": [
                "Hold Menu: what the",
                "knobs do now. With",
                "Shift: Shift layer.",
                "",
                "Knobs:",
                "1 Play mode",
                "2 Step length",
                "3 Strum speed or",
                "  arp rate",
                "4 Sound: on, muted,",
                "  hold",
                "5 Volume",
                "6 Bass on/off",
                "7 Spread",
                "8 Feel",
                "",
                "Shift + knobs:",
                "1 Key  2 Scale",
                "5 Chord track",
                "6 Bass track",
                "7 MIDI out",
                "8 Pad colours",
                "Key and scale are",
                "Bloom's own (* on",
                "screen) until the",
                "Set's key changes."
            ]
        },
        {
            "title": "Other buttons",
            "lines": [
                "-/+: octave.",
                "Shift+-/+: shift",
                "chord rows a",
                "semitone.",
                "",
                "Shift+wheel click:",
                "out-of-key chords",
                "on or off.",
                "Wheel click: smooth",
                "voice leading.",
                "",
                "Delete+chord pad:",
                "stop a held chord.",
                "Shift+Delete: all",
                "notes off."
            ]
        },
        {
            "title": "Routing",
            "lines": [
                "Tracks on MIDI In",
                "Auto only hear the",
                "selected track, so",
                "Bloom selects the",
                "chord track for you.",
                "",
                "For live bass on its",
                "own track, set that",
                "track's MIDI In to",
                "a channel: Shift +",
                "track button."
            ]
        },
        {
            "title": "Track buttons",
            "lines": [
                "Hold a track button",
                "and turn Volume:",
                "track volume.",
                "Mute+track: mute.",
                "Delete+track: delete",
                "its playing clip.",
                "Shift+Undo: Move's",
                "own Undo."
            ]
        },
        {
            "title": "External gear",
            "lines": [
                "Shift+knob 7:",
                "MIDI out to Move,",
                "Move + USB, or USB.",
                "",
                "USB is the USB-A",
                "port: chords on",
                "channel 1, bass on",
                "channel 2.",
                "",
                "Recording always",
                "goes to Move tracks."
            ]
        }
    ]
}
